# Copy to engine/.env and fill in. Never commit the real file.

# Required: Nebius Token Factory key (https://tokenfactory.nebius.com -> API keys).
# Credits: code NEBIUS-DEVPOST-GLOBAL26 on the hackathon credits form.
NEBIUS_API_KEY=

# Optional override; this is the documented default.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Required for prior-art search (Best Use of Tavily bonus). https://app.tavily.com
TAVILY_API_KEY=

# Optional: lets the fix stage open draft PRs on a fork you control.
GITHUB_TOKEN=

# Optional model overrides. Leave blank to auto-resolve from the Token Factory model list.
PG_MODEL_NANO=
PG_MODEL_OMNI=
PG_MODEL_SUPER=
PG_MODEL_ULTRA=

# Sandbox backend for reproduction: openshell | docker | off
PG_SANDBOX=docker

# Where repos and caches live (default: ~/.cache/proofgate)
PG_CACHE_DIR=

# Hard cap on Token Factory spend per report, in USD.
PG_MAX_COST_PER_REPORT=0.25
